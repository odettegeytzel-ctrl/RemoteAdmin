# Credenciales de RemoteAdmin
# Copia este archivo como .env y rellena los valores.
# El .env real está en .gitignore y NO debe subirse al repositorio.

AUTH_USERNAME=admin

# Nunca guardes la contraseña en texto plano.
# Genera el hash con:   python -m backend.auth
AUTH_PASSWORD_HASH=

# Clave para firmar los tokens de sesión. Usa un valor largo y aleatorio, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# Horas de validez de la sesión
AUTH_TOKEN_HOURS=12
