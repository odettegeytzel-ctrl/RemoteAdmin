# Credenciales de RemoteAdmin
# Copia este archivo como .env y rellena los valores.
# El .env real está en .gitignore y NO debe subirse al repositorio.

AUTH_USERNAME=admin

# Semilla inicial, OPCIONAL. La contraseña vigente vive en la tabla
# auth_state de la base de datos: este valor solo se copia la primera vez,
# si esa tabla esta vacia, y a partir de ahi deja de tener efecto.
#
# En una instalacion nueva puedes dejarlo vacio y poner la contraseña
# desde la consola del servidor con:   python reset_password.py
#
# Nunca guardes la contraseña en texto plano.
AUTH_PASSWORD_HASH=

# Clave para firmar los tokens de sesión. Usa un valor largo y aleatorio, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# Horas de validez de la sesión
AUTH_TOKEN_HOURS=12

# Direccion publica por la que se llega a este servidor desde internet.
# Es la UNICA configuracion de la URL publica: de aqui la toman el panel
# para generar el instalador del Agent y los enlaces de recuperacion.
# Sin ella, la descarga del instalador se rechaza en vez de entregar un
# paquete que apunte al propio equipo.
#   REMOTEADMIN_PUBLIC_URL=https://panel.tudominio.com
REMOTEADMIN_PUBLIC_URL=

# Credencial de ALTA de un Agent. Esto va en el .env de la PC administrada,
# NO en el del servidor.
#
# Ya no existe un token compartido: cada equipo se da de alta con una
# credencial de su organizacion (empieza por rae_), que se genera en el
# panel, en "Instalar equipo". Solo sirve para el primer registro: despues
# el Agent usa su token individual y esta linea se vacia sola.
AGENT_TOKEN=

# CA con la que el Agent valida el certificado TLS del servidor.
# Solo para DESARROLLO con la CA local (certs/generate-dev-cert.sh).
# Déjalo vacío en producción: entonces se validan con las autoridades estándar.
# La ruta es relativa a la raíz del proyecto.
# No desactiva la verificación TLS: solo indica en quién confiar.
#   REMOTEADMIN_CA_CERT=certs/dev-ca-cert.pem
REMOTEADMIN_CA_CERT=
