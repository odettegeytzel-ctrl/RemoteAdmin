# Credenciales de RemoteAdmin
# Copia este archivo como .env y rellena los valores.
# El .env real está en .gitignore y NO debe subirse al repositorio.

AUTH_USERNAME=admin

# Nunca guardes la contraseña en texto plano.
# Genera el hash con:   python -m backend.auth
AUTH_PASSWORD_HASH=

# Clave para firmar los tokens de sesión. Usa un valor largo y aleatorio, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# Horas de validez de la sesión
AUTH_TOKEN_HOURS=12

# Token compartido para autenticar los Agents (register, heartbeat y WebSocket).
# Debe ser el MISMO valor en el .env del servidor y en el .env de cada PC con Agent.
# Genera uno con:   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# CA con la que el Agent valida el certificado TLS del servidor.
# Solo para DESARROLLO con la CA local (certs/generate-dev-cert.sh).
# Déjalo vacío en producción: entonces se validan con las autoridades estándar.
# La ruta es relativa a la raíz del proyecto.
# No desactiva la verificación TLS: solo indica en quién confiar.
#   REMOTEADMIN_CA_CERT=certs/dev-ca-cert.pem
REMOTEADMIN_CA_CERT=
